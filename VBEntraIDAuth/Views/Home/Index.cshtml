@* Read claim type and claim value in table after verifying user authicatied  *@
@if (User.Identity.IsAuthenticated)
{
    <h1>Welcome :   @ViewData["GraphApiResult"]</h1>
    <h2>User Claims</h2>
    <table class="table">
        <thead>
            <tr>
                <th>Claim Type</th>
                <th>Claim Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var claim in User.Claims)
            {
                <tr>
                    <td>@claim.Type</td>
                    <td>@claim.Value</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <h2>Please log in to see your claims.</h2>
}

<br />
